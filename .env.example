# Salin file ini menjadi ".env" lalu isi nilainya. File ".env" tidak boleh di-commit.

# [WAJIB] Koneksi POOLED ke PostgreSQL, dipakai aplikasi saat runtime (serverless).
# Neon: pakai host yang mengandung "-pooler". Supabase (port 6543): tambahkan "&pgbouncer=true".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# [WAJIB] Koneksi LANGSUNG (tanpa pooler), dipakai Prisma Migrate (db:migrate / db:deploy).
# Neon: host yang sama tetapi TANPA "-pooler". Supabase: koneksi port 5432.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# [WAJIB] Kunci rahasia Auth.js untuk menandatangani sesi (minimal 32 karakter).
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# [OPSIONAL] Zona waktu bisnis (IANA). Jam buka/tutup dan slot dihitung di zona ini,
# karena server Vercel berjalan di UTC. Default: Asia/Jakarta (WIB).
# Contoh lain: Asia/Makassar (WITA), Asia/Jayapura (WIT).
BUSINESS_TIMEZONE="Asia/Jakarta"

# [OPSIONAL] Nama bisnis yang tampil di header dan judul halaman. Default: Servis Kita.
BUSINESS_NAME="Servis Kita"

# [WAJIB UNTUK SEED] Email akun admin yang dibuat/diperbarui oleh "npm run db:seed".
SEED_ADMIN_EMAIL="admin@example.com"

# [WAJIB UNTUK SEED] Password akun admin (minimal 8 karakter). Ganti sebelum seed ke produksi.
SEED_ADMIN_PASSWORD="ganti-password-ini"

# [OPSIONAL] Nama tampilan admin. Default: Admin.
SEED_ADMIN_NAME="Admin"
